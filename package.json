{
  "name": "cantelop-agents-api-example",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "cantelop dev",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "build": "cantelop deploy --dry-run",
    "env:upload": "node scripts/upload-env.mjs",
    "db:setup": "node --env-file-if-exists=.env --import tsx scripts/setup-session-db.ts"
  },
  "dependencies": {
    "@cantelop/sdk": "0.8.1",
    "@libsql/client": "0.18.0",
    "@opencode-ai/sdk": "1.18.30"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
