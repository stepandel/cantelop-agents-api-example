API_TOKEN=replace-with-a-long-random-secret
GITHUB_TOKEN=replace-with-a-fine-grained-token
GITHUB_WEBHOOK_SECRET=replace-with-another-random-secret
GITHUB_REPOSITORIES=your-name/your-repo
WORKSPACE_SLUG=agents
# Default for GitHub issues; repository rules can override it.
GITHUB_ISSUE_MODEL=moonshotai/kimi-k3
# API-created sessions still supply their model in the request.
OPENROUTER_API_KEY=

# Shared libSQL query index (e.g. Turso). Run npm run db:setup before enabling it.
SESSION_DATABASE_URL=
SESSION_DATABASE_AUTH_TOKEN=
