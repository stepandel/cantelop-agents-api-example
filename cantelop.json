{
  "app": "cantelop-agents-api-example",
  "api": "src/api.ts",
  "session": { "entrypoint": "src/session.ts", "dockerfile": "docker/Dockerfile" },
  "environment": {
    "API_TOKEN": { "secret": true, "required": true },
    "GITHUB_TOKEN": { "secret": true, "required": true },
    "GITHUB_WEBHOOK_SECRET": { "secret": true, "required": true },
    "GITHUB_REPOSITORIES": { "required": true },
    "GITHUB_ISSUE_MODEL": { "default": "moonshotai/kimi-k3" },
    "WORKSPACE_SLUG": { "default": "agents" },
    "SESSION_DATABASE_URL": {},
    "SESSION_DATABASE_AUTH_TOKEN": { "secret": true },
    "OPENROUTER_API_KEY": { "secret": true, "required": true }
  }
}
